{
  "allowedTools": [
    "read",
    "bash",
    "grep",
    "find",
    "ls",
    "web_search",
    "web_fetch",
    "artifact",
    "mcp__context7__resolve_library_id",
    "mcp__context7__query_docs"
  ],
  "bashPatterns": {
    "safePatterns": [
      "^\\s*(rtk\\s+)?cat\\b",
      "^\\s*(rtk\\s+)?head\\b",
      "^\\s*(rtk\\s+)?tail\\b",
      "^\\s*(rtk\\s+)?less\\b",
      "^\\s*(rtk\\s+)?more\\b",
      "^\\s*(rtk\\s+)?grep\\b",
      "^\\s*(rtk\\s+)?find\\b",
      "^\\s*(rtk\\s+)?ls\\b",
      "^\\s*(rtk\\s+)?pwd\\b",
      "^\\s*(rtk\\s+)?cd\\b",
      "^\\s*(rtk\\s+)?echo\\b",
      "^\\s*(rtk\\s+)?printf\\b",
      "^\\s*(rtk\\s+)?wc\\b",
      "^\\s*(rtk\\s+)?sort\\b",
      "^\\s*(rtk\\s+)?diff\\b",
      "^\\s*(rtk\\s+)?file\\b",
      "^\\s*(rtk\\s+)?stat\\b",
      "^\\s*(rtk\\s+)?du\\b",
      "^\\s*(rtk\\s+)?df\\b",
      "^\\s*(rtk\\s+)?tree\\b",
      "^\\s*(rtk\\s+)?which\\b",
      "^\\s*(rtk\\s+)?whereis\\b",
      "^\\s*(rtk\\s+)?type\\b",
      "^\\s*(rtk\\s+)?env\\b",
      "^\\s*(rtk\\s+)?printenv\\b",
      "^\\s*(rtk\\s+)?uname\\b",
      "^\\s*(rtk\\s+)?whoami\\b",
      "^\\s*(rtk\\s+)?date\\b",
      "^\\s*(rtk\\s+)?uptime\\b",
      "^\\s*(rtk\\s+)?ps\\b",
      "^\\s*(rtk\\s+)?free\\b",
      "^\\s*(rtk\\s+)?rg\\b",
      "^\\s*(rtk\\s+)?fd\\b",
      "^\\s*(rtk\\s+)?bat\\b",
      "^\\s*(rtk\\s+)?jq\\b",
      "^\\s*(rtk\\s+)?git\\s+(status|log|diff|show|branch|remote)",
      "^\\s*(rtk\\s+)?node\\s+--version",
      "^\\s*(rtk\\s+)?python\\s+--version",
      "^\\s*(rtk\\s+)?(npx\\s+)?tsc\\b.*--noEmit",
      "^\\s*(rtk\\s+)?npm\\s+(list|ls|view|info|outdated|audit)",
      "^\\s*(rtk\\s+)?yarn\\s+(list|info|why|audit)",
      "^\\s*rtk\\s+read\\b"
    ]
  },
  "shortcuts": {
    "toggleMode": "alt+shift+tab"
  },
  "ui": {
    "hideNotify": true,
    "hideWidget": true
  }
}
