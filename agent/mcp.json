{
  "mcpServers": {
    "aws-knowledge": {
      "type": "http",
      "url": "https://knowledge-mcp.global.api.aws"
    },
    "buildkite": {
      "type": "http",
      "url": "https://mcp.buildkite.com/mcp/readonly"
    },
    "context7": {
      "exposure": "direct",
      "headers": {
        "CONTEXT7_API_KEY": "${CONTEXT7_API_KEY}"
      },
      "type": "http",
      "url": "https://mcp.context7.com/mcp"
    },
    "imds-broker": {
      "args": ["mcp"],
      "command": "imds-broker"
    },
    "sandy": {
      "args": ["mcp"],
      "command": "sandy"
    }
  }
}
