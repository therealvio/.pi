{
  "enabled": true,
  "enableWeakerNetworkIsolation": true,
  "network": {
    "allowLocalBinding": true,
    "allowAllUnixSockets": false,
    "allowUnixSockets": [
      "/nix/var/nix/daemon-socket",
      "/private/tmp/claude",
      "/private/var/run/nix-daemon.socket",
      "~/Library/Application Support/rex",
      "~/tries"
    ],
    "allowMachLookup": [
      "com.apple.FSEvents"
    ],
    "allowedDomains": [
      "localhost",
      "registry.npmjs.org",
      "*.npmjs.org",
      "registry.yarnpkg.com",
      "*.pypi.org",
      "files.pythonhosted.org",
      "proxy.golang.org",
      "sum.golang.org",
      "storage.googleapis.com",
      "github.com",
      "*.github.com",
      "raw.githubusercontent.com",
      "release-assets.githubusercontent.com",
      "ghcr.io",
      "pkg-containers.githubusercontent.com",
      "*.schemastore.org",
      "opentelemetry.io"
    ]
  },
  "filesystem": {
    "denyRead": [
      ".envrc.private",
      "~/.ssh",
      "~/.aws",
      "~/.gnupg",
      "~/Library/Keychains"
    ],
    "allowRead": [
      ".",
      "~/.pi/agent",
      "~/.agents/skills"
    ],
    "allowWrite": [
      ".",
      "/tmp",
      "/private/tmp",
      "/private/var/folders",
      "~/.npm",
      "~/.cache",
      "~/Library/Caches",
      "/Users/brew/Library/Caches",
      "~/.worktrees",
      "~/go/pkg",
      "~/.gradle",
      "~/.local/state/mise",
      "~/.local/share/direnv"
    ],
    "allowGitConfig": true,
    "denyWrite": [
      "/bin",
      "/sbin",
      "/usr/bin",
      "/usr/sbin",
      ".env",
      ".env.*",
      "*.pem",
      "*.key",
      "./.pi/sandbox.json",
      "~/.pi/agent/sandbox.json"
    ]
  }
}
