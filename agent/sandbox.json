{
  "enabled": true,
  "enableWeakerNetworkIsolation": true,
  "network": {
    "allowLocalBinding": true,
    "allowedDomains": [
      "registry.npmjs.org",
      "proxy.golang.org",
      "sum.golang.org",
      "storage.googleapis.com",
      "github.com",
      "api.github.com",
      "raw.githubusercontent.com",
      "opentelemetry.io"
    ]
  },
  "filesystem": {
    "denyRead": [
      ".envrc.private",
      "~/.ssh",
      "~/.aws"
    ],
    "allowRead": [
      ".",
      "~/.pi/agent",
      "~/.agents/skills"
    ],
    "allowWrite": [
      ".",
      "/tmp",
      "/private/tmp",
      "/private/var/folders",
      "~/.npm",
      "~/.cache",
      "~/Library/Caches",
      "/Users/brew/Library/Caches",
      "~/.worktrees",
      "~/go/pkg",
      "~/.gradle",
      "~/.local/state/mise",
      "~/.local/share/direnv"
    ],
    "allowGitConfig": true,
    "denyWrite": [
      ".env",
      ".env.*",
      "*.pem",
      "*.key",
      "./.pi/sandbox.json",
      "~/.pi/agent/sandbox.json"
    ]
  }
}
